<hyperparams> ::= {"'n_estimators'": <n_estimators>, "'max_depth'": <max_depth>, "'min_samples_split'": <min_samples_split>, "'min_samples_leaf'": <min_samples_leaf>, "'criterion'": <criterion>}

<n_estimators> ::= 20 | 40 | 60 | 80 | 100 | 120 | 150 | 180 | 220 | 260 | 300
<max_depth> ::= 2 | 3 | 4 | 5 | 6 | 7 | 8 | 10 | 12 | 15 | 20
<min_samples_split> ::= 2 | 3 | 4 | 5 | 6 | 8 | 10 | 12 | 15 | 20
<min_samples_leaf> ::= 1 | 2 | 3 | 4 | 5 | 6 | 8 | 10
<criterion> ::= "'gini'" | "'entropy'"
