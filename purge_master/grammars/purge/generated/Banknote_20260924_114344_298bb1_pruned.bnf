<hyperparameters> ::= {"'n_estimators'": <n_estimators>, "'max_depth'": <max_depth>, "'min_samples_split'": <min_samples_split>, "'min_samples_leaf'": <min_samples_leaf>, "'criterion'": <criterion>}
<n_estimators> ::= 300
<max_depth> ::= 10 | 12 | 15
<min_samples_split> ::= 2 | 3 | 4 | 5 | 6 | 8 | 10 | 15
<min_samples_leaf> ::= 1 | 3 | 5 | 8 | 10
<criterion> ::= "'gini'"
